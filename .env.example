# Environment Variables Template
# Copy this file to .env.local for local development with MongoDB Atlas

# 1. MongoDB Atlas Connection String
# Leave unset or empty to use zero-config local JSON file storage fallback (ideal for tests and offline development)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.eyhewmy.mongodb.net/doc_editor?retryWrites=true&w=majority

# 2. Database Name (Optional - defaults to 'doc_editor' if omitted)
MONGODB_DB=doc_editor
